# Anthropic Claude API Key (Optional: falls back to built-in keyword heuristic parser if empty)
CLAUDE_API_KEY=your_anthropic_api_key_here

# Razorpay Test Mode API Credentials (Required for payment gateway popups & server verification)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Buyer Agent Shared Secret for HMAC-SHA256 mandate signing (/api/agent/*)
AGENT_BUYER_SECRET=your_shared_hmac_secret_here
